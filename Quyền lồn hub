-- ================== BUTTON KILL AURA ==================
local KillAuraBtn = Instance.new("TextButton", Frame)
KillAuraBtn.Size = UDim2.new(0.9, 0, 0, 35)
KillAuraBtn.Position = UDim2.new(0.05, 0, 0.4, 0)
KillAuraBtn.Text = "Kill Aura: OFF"
KillAuraBtn.Font = Enum.Font.GothamBold
KillAuraBtn.TextSize = 14
KillAuraBtn.TextColor3 = Color3.new(1,1,1)
KillAuraBtn.BackgroundColor3 = Color3.fromRGB(50,50,50)
Instance.new("UICorner", KillAuraBtn).CornerRadius = UDim.new(0, 8)

local ActiveKillAura = false
local DistanceForKillAura = 15

local function runKillAura()
    task.spawn(function()
        while ActiveKillAura do
            local character = player.Character or player.CharacterAdded:Wait()
            local hrp = character:WaitForChild("HumanoidRootPart")

            local weapon = player.Inventory:FindFirstChild("Old Axe")
                or player.Inventory:FindFirstChild("Good Axe")
                or player.Inventory:FindFirstChild("Strong Axe")
                or player.Inventory:FindFirstChild("Chainsaw")

            if weapon then
                for _, mob in pairs(workspace.Characters:GetChildren()) do
                    if mob:IsA("Model") and mob.PrimaryPart and mob ~= character then
                        local distance = (mob.PrimaryPart.Position - hrp.Position).Magnitude
                        if distance <= DistanceForKillAura then
                            ReplicatedStorage.RemoteEvents.ToolDamageObject:InvokeServer(
                                mob, weapon, 999, hrp.CFrame
                            )
                        end
                    end
                end
            end
            task.wait(0.1)
        end
    end)
end

KillAuraBtn.MouseButton1Click:Connect(function()
    ActiveKillAura = not ActiveKillAura
    KillAuraBtn.Text = ActiveKillAura and "Kill Aura: ON" or "Kill Aura: OFF"
    if ActiveKillAura then
        runKillAura()
    end
end)

-- ================== LOGIC MƯA GỖ ==================
RainWood.MouseButton1Click:Connect(function()
    local list = {}
    for _, item in ipairs(workspaceItems:GetChildren()) do
        if item.Name:find("Log") then
            local part = getTargetPart(item)
            if part then
                part.Position = randomPosAboveHumanoid()
                table.insert(list, item)
            end
        end
    end
    if #list == 0 then
        showNotification("Server hết log, đi khám phá/mở rộng bản đồ")
    else
        for _, it in ipairs(list) do
            startDrag(it)
        end
        task.wait()
        for _, it in ipairs(list) do
            stopDrag(it)
        end
    end
end)

