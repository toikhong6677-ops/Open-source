local char = player.Character or player.CharacterAdded:Wait()
local hrp = char:WaitForChild("HumanoidRootPart")
local workspaceItems = workspace:WaitForChild("Items")

-- ================== CẦM / THẢ ==================
local function startDrag(item)
    pcall(function()
        ReplicatedStorage.RemoteEvents.RequestStartDraggingItem:FireServer(item)
    end)
end

local function stopDrag(item)
    pcall(function()
        ReplicatedStorage.RemoteEvents.StopDraggingItem:FireServer(item)
    end)
end

-- ================== RANDOM POSITION ==================
local function randomPosAboveHumanoid()
    local x = hrp.Position.X + math.random(-20, 20)
    local y = hrp.Position.Y + math.random(50, 110)
    local z = hrp.Position.Z + math.random(-20, 20)
    return Vector3.new(x, y, z)
end

local function getTargetPart(item)
    if item:IsA("Model") and item.PrimaryPart then
        return item.PrimaryPart
    end
    for _, v in ipairs(item:GetDescendants()) do
        if v:IsA("BasePart") then
            return v
        end
    end
end

