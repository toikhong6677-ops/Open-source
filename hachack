local function setupChildButton(title, desc, targetName)
    Tab:Button({
        Title = title,
        Desc = desc,
        Locked = false,
        Callback = function()
            local Players = game:GetService("Players")
            local TweenService = game:GetService("TweenService")
            local p = Players.LocalPlayer
            local c = p.Character or p.CharacterAdded:Wait()
            local root = c:WaitForChild("HumanoidRootPart")
            local originalCFrame = root.CFrame

            local function findLostChild()
                local charactersFolder = workspace:WaitForChild("Characters")
                for _, child in pairs(charactersFolder:GetChildren()) do
                    if child.Name == targetName then
                        local chrp = child:FindFirstChild("HumanoidRootPart") or child:FindFirstChildWhichIsA("BasePart")
                        if chrp then return chrp end
                    end
                end
                return nil
            end

            local target = findLostChild()
            if not target then
                WindUI:Notify({ Title = "Lỗi hệ thống", Content = "Không tìm thấy đứa trẻ thất lạc, hoặc cấp độ lửa trại quá thấp!", Duration = 3, Icon = "bird" })
            else
                local distance = (root.Position - target.Position).Magnitude
                local tweenInfo = TweenInfo.new(distance / 500, Enum.EasingStyle.Linear)
                local tweenTo = TweenService:Create(root, tweenInfo, {CFrame = target.CFrame + Vector3.new(0, 3, 0)})
                tweenTo:Play()
                tweenTo.Completed:Wait()
                wait(15)
                local tweenBack = TweenService:Create(root, TweenInfo.new(1, Enum.EasingStyle.Linear), {CFrame = originalCFrame})
                tweenBack:Play()
            end
        end
    })
end

