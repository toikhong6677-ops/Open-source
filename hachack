Tab7:Button({
    Title = "Bật bảng chống Sói & Gấu cắn",
    Desc = "Mở bảng điều khiển vô hiệu hóa toàn bộ dã thú",
    Locked = false,
    Callback = function()
        local Players = game:GetService("Players")
        local RunService = game:GetService("RunService")
        local Workspace = game:GetService("Workspace")
        local StarterGui = game:GetService("StarterGui")
        local p = Players.LocalPlayer

        local CHARACTERS_FOLDER = "Characters"
        local WOLF_NAME = {"wolf", "Bear"}
        local HOLD_ABOVE_PLAYER = true
        local COORD_HOLD = Vector3.new(0, 10, 0)
        local tracked = {}
        local enabled = false

        local function isWolfModel(m)
            if not m or not m:IsA("Model") then return false end
            local name = tostring(m.Name):lower()
            for _, pattern in ipairs(WOLF_NAME) do
                if string.find(name, pattern:lower(), 1, true) then return true end
            end
            return false
        end

        local function collectParts(model)
            local parts = {}
            for _, d in ipairs(model:GetDescendants()) do
                if d:IsA("BasePart") then table.insert(parts, d) end
            end
            return parts
        end

        local function saveOriginalState(model)
            if tracked[model] then return end
            local info = {parts = {}, model = model, primaryCFrame = nil}
            local parts = collectParts(model)
            for _, bpart in ipairs(parts) do
                info.parts[bpart] = { Anchored = bpart.Anchored, CanCollide = bpart.CanCollide, CFrame = bpart.CFrame }
            end
            if model.PrimaryPart then info.primaryCFrame = model:GetPrimaryPartCFrame() end
            tracked[model] = info
        end

        local function restoreModel(model)
            local info = tracked[model]
            if not info then return end
            pcall(function()
                for bpart, props in pairs(info.parts) do
                    if bpart and bpart.Parent then
                        pcall(function() bpart.CFrame = props.CFrame end)
                        bpart.Anchored = props.Anchored
                        bpart.CanCollide = props.CanCollide
                    end
                end
                if info.primaryCFrame and model.PrimaryPart then pcall(function() model:SetPrimaryPartCFrame(info.primaryCFrame) end) end
            end)
            tracked[model] = nil
        end

        local function setModelCFrame(model, targetCFrame)
            if not model or not model.Parent then return end
            pcall(function()
                if model.PrimaryPart then
                    model:SetPrimaryPartCFrame(targetCFrame)
                else
                    local parts = collectParts(model)
                    local center = Vector3.new(0,0,0)
                    local n = 0
                    for _, bp in ipairs(parts) do center = center + bp.Position; n = n + 1 end
                    if n == 0 then return end
                    center = center / n
                    for _, bp in ipairs(parts) do
                        local offset = bp.Position - center
                        bp.CFrame = CFrame.new(targetCFrame.Position + offset) * (bp.CFrame - bp.CFrame.Position)
                    end
                end
            end)
        end

        local function neutralizeModel(model)
            saveOriginalState(model)
            for bpart, _ in pairs(tracked[model].parts) do
                if bpart and bpart.Parent then
                    pcall(function() bpart.Anchored = true; bpart.CanCollide = false end)
                end
            end
        end

        local function bringAndHoldAll()
            local targetPos
            if HOLD_ABOVE_PLAYER and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                targetPos = p.Character.HumanoidRootPart.Position + Vector3.new(0, 10, 0)
            else
                targetPos = COORD_HOLD
            end
            local charsFolder = Workspace:FindFirstChild(CHARACTERS_FOLDER) or Workspace
            for _, m in ipairs(charsFolder:GetChildren()) do
                if isWolfModel(m) then
                    saveOriginalState(m)
                    neutralizeModel(m)
                    setModelCFrame(m, CFrame.new(targetPos))
                    if tracked[m] then tracked[m].moved = true end
                end
            end
        end

        local holdConnection
        local function startHoldLoop()
            if holdConnection then return end
            holdConnection = RunService.Heartbeat:Connect(function()
                if not enabled then return end
                local basePos
                if HOLD_ABOVE_PLAYER and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                    basePos = p.Character.HumanoidRootPart.Position + Vector3.new(0, 10, 0)
                else
                    basePos = COORD_HOLD
                end
                local charsFolder = Workspace:FindFirstChild(CHARACTERS_FOLDER) or Workspace
                for _, m in ipairs(charsFolder:GetChildren()) do
                    if isWolfModel(m) then
                        if not tracked[m] then
                            saveOriginalState(m)
                            for bpart, _ in pairs(tracked[m].parts) do
                                pcall(function() bpart.Anchored = true; bpart.CanCollide = false end)
                            end
                            tracked[m].moved = true
                        end
                        local hash = math.abs(tonumber(tostring(m:GetDebugId())) or 0)
                        local offsetIndex = (hash % 6) - 3
                        local target = CFrame.new(basePos + Vector3.new(offsetIndex*2, 0, 0))
                        pcall(function() setModelCFrame(m, target) end)
                    end
                end
            end)
        end

        local function stopHoldLoop()
            if holdConnection then holdConnection:Disconnect(); holdConnection = nil end
        end

        local function releaseAll()
            for model, _ in pairs(tracked) do pcall(function() restoreModel(model) end) end
            tracked = {}
        end

        local screenGui = Instance.new("ScreenGui")
        screenGui.Name = "AntiWolfBringGUI"
        screenGui.ResetOnSpawn = false
        screenGui.Parent = p:WaitForChild("PlayerGui")

        local main = Instance.new("Frame", screenGui)
        main.Size = UDim2.new(0, 300, 0, 140)
        main.Position = UDim2.new(0, 12, 0, 12)
        main.BackgroundColor3 = Color3.fromRGB(30,30,30)
        main.BackgroundTransparency = 0.12
        main.BorderSizePixel = 0
        main.Draggable = true

        local title = Instance.new("TextLabel", main)
        title.Size = UDim2.new(1, -12, 0, 28)
        title.Position = UDim2.new(0, 6, 0, 6)
        title.BackgroundTransparency = 1
        title.Text = "Khống chế Sói: Trói trên không"
        title.TextColor3 = Color3.new(1,1,1)
        title.Font = Enum.Font.SourceSansBold
        title.TextSize = 18

        local toggleBtn = Instance.new("TextButton", main)
        toggleBtn.Size = UDim2.new(0, 140, 0, 34)
        toggleBtn.Position = UDim2.new(0, 6, 0, 40)
        toggleBtn.Text = "Kích hoạt"
        toggleBtn.BackgroundColor3 = Color3.fromRGB(70,70,70)
        toggleBtn.TextColor3 = Color3.new(1,1,1)

        local modeBtn = Instance.new("TextButton", main)
        modeBtn.Size = UDim2.new(0, 140, 0, 34)
        modeBtn.Position = UDim2.new(0, 156, 0, 40)
        modeBtn.Text = "Chế độ: Trên đầu"
        modeBtn.BackgroundColor3 = Color3.fromRGB(70,70,70)
        modeBtn.TextColor3 = Color3.new(1,1,1)

        local scanBtn = Instance.new("TextButton", main)
        scanBtn.Size = UDim2.new(0, 140, 0, 28)
        scanBtn.Position = UDim2.new(0, 6, 0, 84)
        scanBtn.Text = "Quét mục tiêu"
        scanBtn.BackgroundColor3 = Color3.fromRGB(80,80,80)
        scanBtn.TextColor3 = Color3.new(1,1,1)

        local releaseBtn = Instance.new("TextButton", main)
        releaseBtn.Size = UDim2.new(0, 140, 0, 28)
        releaseBtn.Position = UDim2.new(0, 156, 0, 84)
        releaseBtn.Text = "Đóng giao diện"
        releaseBtn.BackgroundColor3 = Color3.fromRGB(80,80,80)
        releaseBtn.TextColor3 = Color3.new(1,1,1)

        toggleBtn.MouseButton1Click:Connect(function()
            enabled = not enabled
            if enabled then
                toggleBtn.Text = "Vô hiệu hóa"
                bringAndHoldAll()
                startHoldLoop()
                StarterGui:SetCore("SendNotification", {Title="Chống Sói", Text="Đã trói toàn bộ sói", Duration=2})
            else
                toggleBtn.Text = "Kích hoạt"
                stopHoldLoop()
                releaseAll()
                StarterGui:SetCore("SendNotification", {Title="Chống Sói", Text="Đã thả tự do cho sói", Duration=2})
            end
        end)

        modeBtn.MouseButton1Click:Connect(function()
            HOLD_ABOVE_PLAYER = not HOLD_ABOVE_PLAYER
            modeBtn.Text = HOLD_ABOVE_PLAYER and "Chế độ: Trên đầu" or "Chế độ: Tọa độ cố định"
        end)

        scanBtn.MouseButton1Click:Connect(function()
            bringAndHoldAll()
        end)

        releaseBtn.MouseButton1Click:Connect(function() main.Visible = false end)
    end
})
