local function runKillAura()
    task.spawn(function()
        while ActiveKillAura do
            local p = game.Players.LocalPlayer
            local c = p.Character or p.CharacterAdded:Wait()
            local chrp = c:WaitForChild("HumanoidRootPart")
            local weapon = p.Inventory:FindFirstChild("Old Axe") or p.Inventory:FindFirstChild("Good Axe") or p.Inventory:FindFirstChild("Strong Axe") or p.Inventory:FindFirstChild("Chainsaw")

            if weapon then
                for _, mob in pairs(workspace.Characters:GetChildren()) do
                    if mob:IsA("Model") and mob.PrimaryPart and mob ~= c then
                        local distance = (mob.PrimaryPart.Position - chrp.Position).Magnitude
                        if distance <= DistanceForKillAura then
                            game:GetService("ReplicatedStorage").RemoteEvents.ToolDamageObject:InvokeServer(mob, weapon, 999, chrp.CFrame)
                        end
                    end
                end
            end
            task.wait(0.1)
        end
    end)
end

